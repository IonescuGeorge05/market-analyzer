# Copy this file to .env and fill in your keys. NEVER commit .env

# Which LLM the Analyzer and Reporter talk to: anthropic | openai
# Only the matching key below has to be set. See app/llm.py.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...

# Optional: use a free or cheaper OpenAI-compatible provider through the
# "openai" setting above. Leave blank for OpenAI itself. Examples:
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1
# Put that provider's key in OPENAI_API_KEY and its model name in OPENAI_MODEL.
OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

NEWSAPI_KEY=
ALPHAVANTAGE_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit rejects generic user agents. Format: platform:app-id:version (by /u/you)
REDDIT_USER_AGENT=windows:market-sentiment-analyzer:0.1 (by /u/yourusername)
