# Copy this file to .env and fill in your keys. NEVER commit .env

# Which LLM the Analyzer and Reporter talk to: anthropic | openai
# Only the matching key below has to be set. See app/llm.py.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...

NEWSAPI_KEY=
ALPHAVANTAGE_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit rejects generic user agents. Format: platform:app-id:version (by /u/you)
REDDIT_USER_AGENT=windows:market-sentiment-analyzer:0.1 (by /u/yourusername)
